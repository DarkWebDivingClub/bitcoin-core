#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# Server binaries only: no GUI, no test binaries, no bench.
override_dh_auto_configure:
	dh_auto_configure -- \
	  -DBUILD_GUI=OFF \
	  -DBUILD_TESTS=OFF \
	  -DBUILD_BENCH=OFF \
	  -DBUILD_FUZZ_BINARY=OFF \
	  -DBUILD_UTIL=ON \
	  -DBUILD_CLI=ON \
	  -DBUILD_DAEMON=ON \
	  -DENABLE_WALLET=ON \
	  -DWITH_ZMQ=ON

# Upstream ships no test suite in this configuration.
override_dh_auto_test:
